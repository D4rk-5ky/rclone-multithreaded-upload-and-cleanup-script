{
  "script_name": "Camera archive upload",
  "comment": "",
  "completion": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 1883,
    "topic": "homeassistant/rclone-upload/result",
    "username": "",
    "password": null,
    "qos": 0,
    "timeout": 15,
    "on_success": true,
    "send_on_dry_run": true,
    "tls": false,
    "client_id": "",
    "ca_certs": null,
    "certfile": null,
    "keyfile": null
  },
  "live": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 1883,
    "username": "",
    "password": null,
    "qos": 1,
    "timeout": 5,
    "tls": false,
    "device_id": "rclone_multithreaded_upload",
    "topic_prefix": "rclone-upload/live",
    "discovery": true,
    "discovery_prefix": "homeassistant",
    "send_on_dry_run": false,
    "heartbeat_seconds": 10,
    "min_publish_interval": 1,
    "expire_after": 45,
    "discovery_interval": 300,
    "final_wait": 1,
    "client_id": "",
    "ca_certs": null,
    "certfile": null,
    "keyfile": null,
    "manufacturer": "rclone-multithreaded-upload"
  },
  "delete_min_age": "31d",
  "lock_file": "/var/lock/rclone-cleanup/rclone-cleanup.lock",
  "delete_list_dir": "/var/tmp/rclone-cleanup-delete-lists",
  "sleep_after_step": 5,
  "thread_limits": {
    "upload_threads": 2,
    "cleanup_threads": 2,
    "remote_quota_cleanup_threads": 2,
    "trash_cleanup_threads": 2
  },
  "upload_directories": [
    {
      "name": "Primary archive",
      "local_path": "/srv/camera/archive/",
      "remote_path": "Example-GDrive-Encrypted:CameraArchive",
      "upload_command": "copy",
      "delete_old_files": true,
      "delete_excess_files": true,
      "max_total_size": "500G",
      "delete_to_trash": false,
      "empty_trash": true,
      "buffer_size": "64M",
      "cleanup_rules": [
        {
          "path": "/",
          "max_files": null,
          "max_size": "500G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "FrontDoor",
          "max_files": 25000,
          "max_size": "150G",
          "delete_old_files": false,
          "delete_excess_files": true,
          "delete_to_trash": false
        }
      ],
      "copy_options": [
        "--max-age",
        "12h",
        "--transfers",
        "4",
        "--exclude",
        "/Temporary/**"
      ]
    },
    {
      "name": "Mirror archive",
      "local_path": "/srv/camera/archive/",
      "remote_path": "Example-OneDrive-Encrypted:CameraMirror",
      "upload_command": "sync",
      "delete_old_files": false,
      "delete_excess_files": true,
      "max_total_size": "250G",
      "delete_to_trash": true,
      "empty_trash": true,
      "buffer_size": null,
      "cleanup_rules": [
        {
          "path": "/",
          "max_files": 100000,
          "max_size": "250G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        }
      ],
      "copy_options": [
        "--max-age=24h",
        "--transfers=2"
      ]
    },
    {
      "name": "Move completed exports",
      "local_path": "/srv/camera/completed-exports/",
      "remote_path": "Example-Mega-Encrypted:CompletedExports",
      "upload_command": "move",
      "delete_old_files": true,
      "delete_excess_files": false,
      "max_total_size": null,
      "delete_to_trash": false,
      "empty_trash": false,
      "buffer_size": "16M",
      "cleanup_rules": [
        {
          "path": "/",
          "max_files": null,
          "max_size": null,
          "delete_old_files": true,
          "delete_excess_files": false,
          "delete_to_trash": false
        }
      ],
      "copy_options": [
        "--min-age",
        "5m"
      ]
    }
  ]
}
