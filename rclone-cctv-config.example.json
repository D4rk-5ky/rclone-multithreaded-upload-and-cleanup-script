{
  "script_name": "Frigate CCTV upload",
  "mqtt": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 1883,
    "topic": "homeassistant/rclone-upload/result",
    "username": null,
    "password": null,
    "client_id": null,
    "qos": 1,
    "retain": false,
    "keepalive": 60,
    "tls": false,
    "tls_insecure": false,
    "ca_certs": null,
    "publish_timeout": 10
  },
  "delete_min_age": "31d",
  "lock_file": "/var/lock/subsys/RcloneLockFile.run",
  "delete_list_dir": "/root/rclone",
  "sleep_after_step": 5,
  "thread_limits": {
    "upload_threads": 2,
    "cleanup_threads": 2,
    "remote_quota_cleanup_threads": 2,
    "trash_cleanup_threads": 2
  },
  "upload_directories": [
    {
      "name": "Google Drive CCTV",
      "local_path": "/path/to/local/CCTV",
      "remote_path": "Example-GoogleDrive-Encrypted:/CCTV",
      "upload_command": "copy",
      "delete_old_files": true,
      "delete_excess_files": true,
      "max_total_size": "500G",
      "delete_to_trash": false,
      "empty_trash": true,
      "buffer_size": "64M",
      "cleanup_rules": [
        {
          "path": "Home/Camera01",
          "max_files": 80,
          "max_size": null,
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Home/Camera02",
          "max_files": null,
          "max_size": "50G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Garage/Camera03",
          "max_files": 120,
          "max_size": null,
          "delete_old_files": false,
          "delete_excess_files": true,
          "delete_to_trash": false
        },
        {
          "path": "Outside/Camera04",
          "max_files": 200,
          "max_size": "100G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        }
      ],
      "copy_options": [
        "--max-age",
        "3h",
        "--stats",
        "10s",
        "--stats-one-line",
        "--transfers",
        "4",
        "--exclude",
        "/Home/OldCamera/**"
      ]
    },
    {
      "name": "MEGA CCTV",
      "local_path": "/path/to/local/CCTV",
      "remote_path": "Example-Mega-Encrypted:/CCTV",
      "upload_command": "copy",
      "delete_old_files": true,
      "delete_excess_files": true,
      "max_total_size": "250G",
      "delete_to_trash": true,
      "empty_trash": true,
      "buffer_size": "32M",
      "cleanup_rules": [
        {
          "path": "Home/Camera01",
          "max_files": 80,
          "max_size": null,
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Home/Camera02",
          "max_files": null,
          "max_size": "50G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Garage/Camera03",
          "max_files": 120,
          "max_size": null,
          "delete_old_files": false,
          "delete_excess_files": true,
          "delete_to_trash": false
        },
        {
          "path": "Outside/Camera04",
          "max_files": 200,
          "max_size": "100G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        }
      ],
      "copy_options": [
        "--max-age",
        "3h",
        "--stats",
        "10s",
        "--stats-one-line",
        "--transfers",
        "4",
        "--exclude",
        "/Home/OldCamera/**"
      ]
    },
    {
      "name": "OneDrive CCTV",
      "local_path": "/path/to/local/CCTV",
      "remote_path": "Example-OneDrive-Encrypted:/CCTV",
      "upload_command": "sync",
      "delete_old_files": false,
      "delete_excess_files": true,
      "max_total_size": "1T",
      "delete_to_trash": false,
      "empty_trash": false,
      "buffer_size": null,
      "cleanup_rules": [
        {
          "path": "Home/Camera01",
          "max_files": 80,
          "max_size": null,
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Home/Camera02",
          "max_files": null,
          "max_size": "50G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        },
        {
          "path": "Garage/Camera03",
          "max_files": 120,
          "max_size": null,
          "delete_old_files": false,
          "delete_excess_files": true,
          "delete_to_trash": false
        },
        {
          "path": "Outside/Camera04",
          "max_files": 200,
          "max_size": "100G",
          "delete_old_files": null,
          "delete_excess_files": null,
          "delete_to_trash": null
        }
      ],
      "copy_options": [
        "--max-age",
        "3h",
        "--stats",
        "10s",
        "--stats-one-line",
        "--transfers",
        "4",
        "--exclude",
        "/Home/OldCamera/**"
      ]
    }
  ]
}
